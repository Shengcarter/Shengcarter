# =============================================================================
# ZOLA STYLISH MANAGEMENT SYSTEM — environment configuration
#
# Copy this file to ".env" in the project root and fill in the values.
# NEVER commit the real .env file. Every secret below is a placeholder.
# =============================================================================

# ---- Application -------------------------------------------------------------
NODE_ENV=production
# 0.0.0.0 listens on every network interface so other salon computers (LAN)
# can connect. Use 127.0.0.1 to allow only this computer.
HOST=0.0.0.0
PORT=5000
# Public address people type in the browser. Used in QR codes, password-reset
# links and emails. For LAN installs use the server IP, e.g. http://192.168.1.10:5000
APP_URL=http://localhost:5000
# Allowed browser origins for CORS (comma separated). Only needed when the
# frontend is served from a different address than the API (e.g. Vite dev server).
FRONTEND_URL=http://localhost:5173
# Serve the built frontend (frontend/dist) from the API server. Keep "true" for
# Windows/LAN installs; set "false" when Nginx serves the frontend.
SERVE_FRONTEND=true
# Set to "true" when running behind Nginx or another reverse proxy.
TRUST_PROXY=false
# Set to "true" only when the site is served over HTTPS.
COOKIE_SECURE=false

# ---- Database (MySQL 8+) -----------------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=zola_stylish
DATABASE_USER=zola
DATABASE_PASSWORD=change-this-database-password
DATABASE_CONNECTION_LIMIT=10

# ---- Security ----------------------------------------------------------------
# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional separate key for encrypting integration secrets saved from the
# Settings page. Defaults to a key derived from JWT_SECRET.
APP_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
# "Remember me" sessions last this many days; other sessions SESSION_HOURS.
REFRESH_TOKEN_DAYS=30
SESSION_HOURS=12
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- First Super Admin account (read by `npm run seed`) ------------------------
# The administrator is asked to change this password at first login.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Demo data -----------------------------------------------------------------
# "true" loads clearly-labelled demo customers, services, products, staff,
# appointments and sales. Remove it later with `npm run demo:clear`.
SEED_DEMO_DATA=false
# Password for the demo receptionist / stylist / accountant accounts.
DEMO_PASSWORD=

# ---- Email (SMTP) ----------------------------------------------------------------
# Used when the email provider is "smtp" and no value is saved in Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- SMS -----------------------------------------------------------------------
# Africa's Talking: username + API key. Twilio: account SID + auth token.
SMS_USERNAME=
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- WhatsApp Business -----------------------------------------------------------
# Meta WhatsApp Cloud API access token and phone number ID.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ---- AI insights (optional) --------------------------------------------------------
# Leave empty to use the built-in rule-based insights (works fully offline).
# AI_PROVIDER: anthropic | openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Storage, backups & logging ----------------------------------------------------
# Relative paths are resolved from the backend/ folder.
UPLOAD_DIR=storage/uploads
BACKUP_DIR=storage/backups
MAX_UPLOAD_MB=5
LOG_LEVEL=info
LOG_FILE=logs/app.log
# Enable background jobs (reminders, message queue, scheduled backups).
JOBS_ENABLED=true
